{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "canvas-rishirajpal-api",
  "main": "./index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "CATALOGUE", "class_name": "Catalogue" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Catalogue"] },
    { "tag": "v2", "new_sqlite_classes": ["Board"] }
  ]
}
