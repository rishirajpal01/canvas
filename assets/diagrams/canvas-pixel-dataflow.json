{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Canvas Pixel Dataflow and Mutation Pipeline",
    "output": "assets/diagrams/canvas-pixel-dataflow.html",
    "viewBox": [1080, 640],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "batch-drawing",
        "label": "Live drawing & batching",
        "focus": ["single_pixel", "auto_fill", "reveal_queue", "event_api", "board_engine", "ws_peers"],
        "note": "Follow individual and auto-filled pixels through client batching to live broadcast."
      },
      {
        "id": "photo-artwork",
        "label": "Photo upload & full artwork",
        "focus": ["photo_tool", "artwork_buffer", "artwork_api", "board_engine", "sqlite_store"],
        "note": "Client-side image quantization to full board replacement in SQLite."
      },
      {
        "id": "edge-storage",
        "label": "Edge state & persistence",
        "focus": ["event_api", "artwork_api", "board_engine", "sqlite_store", "ws_peers"],
        "note": "In-memory Durable Object coordinates SQLite writes and WebSocket fan-out."
      }
    ]
  },
  "stages": [
    { "label": "Client Tools" },
    { "label": "Client Batching" },
    { "label": "API Gateway" },
    { "label": "Durable State" },
    { "label": "Live Viewers" }
  ],
  "nodes": [
    {
      "id": "single_pixel",
      "type": "frontend",
      "label": "Single Pixel",
      "sublabel": "click or key",
      "stage": 0,
      "row": 0,
      "width": 125,
      "tag": "1 pixel"
    },
    {
      "id": "auto_fill",
      "type": "frontend",
      "label": "Auto Fill",
      "sublabel": "procedural gen",
      "stage": 0,
      "row": 1,
      "width": 125,
      "tag": "procedural"
    },
    {
      "id": "photo_tool",
      "type": "frontend",
      "label": "Photo Import",
      "sublabel": "palette quantizer",
      "stage": 0,
      "row": 2,
      "width": 125,
      "tag": "<= 40k px"
    },
    {
      "id": "reveal_queue",
      "type": "frontend",
      "label": "Batch Queue",
      "sublabel": "1-64 px chunks",
      "stage": 1,
      "row": 0,
      "width": 125,
      "tag": "live-fill"
    },
    {
      "id": "artwork_buffer",
      "type": "frontend",
      "label": "Artwork Buffer",
      "sublabel": "200x200 grid",
      "stage": 1,
      "row": 2,
      "width": 125,
      "tag": "atomic"
    },
    {
      "id": "event_api",
      "type": "backend",
      "label": "Events API",
      "sublabel": "POST /events/batch",
      "stage": 2,
      "row": 0,
      "width": 130,
      "tag": "gen guard",
      "brand": "cloudflare"
    },
    {
      "id": "artwork_api",
      "type": "backend",
      "label": "Artwork API",
      "sublabel": "PUT /artwork",
      "stage": 2,
      "row": 2,
      "width": 130,
      "tag": "atomic replace",
      "brand": "cloudflare"
    },
    {
      "id": "board_engine",
      "type": "database",
      "label": "Board DO",
      "sublabel": "grid memory",
      "stage": 3,
      "row": 0,
      "width": 130,
      "tag": "atomic lock",
      "brand": "cloudflare"
    },
    {
      "id": "sqlite_store",
      "type": "database",
      "label": "DO SQLite",
      "sublabel": "state upsert",
      "stage": 3,
      "row": 2,
      "width": 130,
      "tag": "commit",
      "brand": "sqlite"
    },
    {
      "id": "ws_peers",
      "type": "external",
      "label": "Visitors",
      "sublabel": "WS sessions",
      "stage": 4,
      "row": 0,
      "width": 110,
      "tag": "live render"
    }
  ],
  "flows": [
    {
      "id": "single-to-batch",
      "from": "single_pixel",
      "to": "reveal_queue",
      "label": "enqueue pixel",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "autofill-to-batch",
      "from": "auto_fill",
      "to": "reveal_queue",
      "label": "pattern stream",
      "variant": "default",
      "route": "vertical-channel"
    },
    {
      "id": "photo-to-buffer",
      "from": "photo_tool",
      "to": "artwork_buffer",
      "label": "quantized cells",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "batch-to-api",
      "from": "reveal_queue",
      "to": "event_api",
      "label": "POST batch",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "buffer-to-api",
      "from": "artwork_buffer",
      "to": "artwork_api",
      "label": "PUT artwork",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "events-to-do",
      "from": "event_api",
      "to": "board_engine",
      "label": "apply delta",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "artwork-to-do",
      "from": "artwork_api",
      "to": "board_engine",
      "label": "replace grid",
      "labelDx": -28,
      "variant": "default",
      "route": "vertical-channel"
    },
    {
      "id": "do-to-sqlite",
      "from": "board_engine",
      "to": "sqlite_store",
      "label": "persist JSON",
      "labelDx": 28,
      "variant": "default",
      "route": "vertical-channel"
    },
    {
      "id": "do-to-ws",
      "from": "board_engine",
      "to": "ws_peers",
      "label": "WS fan-out",
      "labelDy": -20,
      "variant": "emphasis",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Local Client Processing",
      "items": [
        "Photo conversion and camera capture run locally in the browser",
        "Original image files are never uploaded; only 16-color palette indices are transmitted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Batching & Atomic Protection",
      "items": [
        "Live fill queues pixels and dispatches batches of 1 to 64 to minimize HTTP overhead",
        "Full artwork uploads and pixel batches verify generation tokens against race conditions"
      ]
    },
    {
      "dot": "orange",
      "title": "Real-time Fan-out",
      "items": [
        "Board DO pushes updated pixel arrays directly across active WebSocket connections",
        "All connected visitors see live artwork develop in real time"
      ]
    }
  ]
}
